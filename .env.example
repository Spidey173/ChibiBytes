# ChibiBytes Environment Configuration Template
# Copy this file to .env and fill in your values (do not commit real credentials!)

# Database Connection (Neon PostgreSQL for Cloud, leave empty for local SQLite fallback)
# Example: postgresql://username:password@ep-sample-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Flask Session Security Key
SECRET_KEY=generate-a-secure-random-secret-key-here

# Google Gemini API Key for AI Assistant (optional, fallback available)
GEMINI_API_KEY=
